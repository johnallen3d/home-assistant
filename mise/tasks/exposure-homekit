#!/usr/bin/env -S uv run --script
#MISE description="Manage HomeKit bridge exposure and Frigate camera accessories"
# /// script
# requires-python = ">=3.12"
# dependencies = ["pyyaml"]
# ///
"""Reconcile homekit_exposed.yaml; --dry-run never changes HA.

Frigate options use the supported options-flow API. HomeKit's API cannot set
linked_motion_sensor or stable names/ports, so only those entries use a locked,
backed-up, atomic storage update with HA stopped. Unmanaged entries are retained.
"""

import argparse
from contextlib import contextmanager
from copy import deepcopy
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tempfile
import time
from urllib.error import HTTPError, URLError
from urllib.parse import quote
from urllib.request import Request, urlopen
from uuid import uuid4

import yaml

FILTER_KEYS = ("include_domains", "include_entities", "exclude_domains", "exclude_entities")
STORAGE = "/config/.storage/core.config_entries"
DEPLOYMENT = "/config/.homekit-exposure-deployment.json"
LOCK = "/config/.home-assistant-deploy.lock"


def load_homekit_config(config_path: Path) -> dict:
    with config_path.open() as file:
        data = yaml.safe_load(file) or {}
    config = {key: data.get(key, []) for key in FILTER_KEYS}
    for key in FILTER_KEYS:
        if not isinstance(config[key], list) or any(not isinstance(x, str) for x in config[key]):
            raise ValueError(f"{key} must be a list of strings")
    config["camera_accessories"] = data.get("camera_accessories", [])
    config["frigate_rtsp"] = data.get("frigate_rtsp")
    validate_accessories(config)
    return config


def bridge_includes(entity: str, filter_config: dict) -> bool:
    """Implement the relevant HA include/exclude precedence for cameras."""
    domain = entity.split(".", 1)[0]
    if entity in filter_config["include_entities"]:
        return True
    if domain in filter_config["include_domains"]:
        return entity not in filter_config["exclude_entities"]
    if filter_config["include_domains"] or filter_config["include_entities"]:
        return False
    return domain not in filter_config["exclude_domains"] and entity not in filter_config["exclude_entities"]


def validate_accessories(config: dict) -> None:
    cameras = config["camera_accessories"]
    if not isinstance(cameras, list):
        raise ValueError("camera_accessories must be a list")
    names, ports, entities = set(), set(), set()
    for camera in cameras:
        if not isinstance(camera, dict) or set(camera) != {"name", "port", "entity_id", "linked_motion_sensor", "video_codec", "support_audio"}:
            raise ValueError("Each camera requires name, port, entity_id, linked_motion_sensor, video_codec, support_audio")
        name, port, entity = camera["name"], camera["port"], camera["entity_id"]
        if not isinstance(name, str) or not name.strip() or len(name) > 64:
            raise ValueError("Camera name must be 1–64 characters")
        if type(port) is not int or not 1024 <= port <= 65535:
            raise ValueError("Camera port must be an integer from 1024 to 65535")
        if not isinstance(entity, str) or not entity.startswith("camera."):
            raise ValueError("Camera entity_id must be in the camera domain")
        motion = camera["linked_motion_sensor"]
        if not isinstance(motion, str) or not motion.startswith("binary_sensor."):
            raise ValueError("linked_motion_sensor must be a binary_sensor")
        if camera["video_codec"] not in ("copy", "libx264") or type(camera["support_audio"]) is not bool:
            raise ValueError("Invalid video_codec or support_audio")
        if name in names or port in ports or entity in entities:
            raise ValueError("Camera names, ports, and entity IDs must each be unique")
        if bridge_includes(entity, config):
            raise ValueError(f"{entity} would also be exposed by the bridge")
        names.add(name)
        ports.add(port)
        entities.add(entity)


def download_config_entries(server: str) -> dict:
    result = subprocess.run(["ssh", server, f"cat {STORAGE}"], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


def find_homekit_bridge_entry(config_entries: dict) -> dict:
    entries = [entry for entry in config_entries["data"]["entries"]
               if entry.get("domain") == "homekit"
               and entry.get("options", {}).get("mode", entry.get("data", {}).get("mode", "bridge")) == "bridge"]
    if len(entries) != 1:
        raise ValueError(f"Expected exactly one HomeKit bridge, found {len(entries)}; refusing to guess")
    return entries[0]


def reconcile_entries(config_entries: dict, config: dict) -> tuple[dict, list[str]]:
    """Pure reconciliation. Preserve IDs, pairing state, unknown options and other entries."""
    updated = deepcopy(config_entries)
    entries = updated["data"]["entries"]
    changes = []
    bridge = find_homekit_bridge_entry(updated)
    desired_filter = {key: config[key] for key in FILTER_KEYS}
    if bridge.get("options", {}).get("filter", {}) != desired_filter:
        bridge.setdefault("options", {})["filter"] = desired_filter
        changes.append(f"Update bridge filter: {bridge['title']}")
    for camera in config["camera_accessories"]:
        entity, name, port = camera["entity_id"], camera["name"], camera["port"]
        matches = [entry for entry in entries if entry.get("domain") == "homekit"
                   and entry.get("options", {}).get("mode") == "accessory"
                   and entry.get("options", {}).get("filter", {}).get("include_entities") == [entity]]
        if len(matches) > 1:
            raise ValueError(f"Multiple accessories already expose {entity}")
        entry = matches[0] if matches else None
        # Matching a camera alone is not permission to adopt somebody else's entry.
        if entry and entry.get("data", {}).get("name") != name:
            raise ValueError(f"Existing accessory for {entity} has another name; reconcile ownership first")
        for other in entries:
            if other is entry or other.get("domain") != "homekit":
                continue
            data = other.get("data", {})
            if data.get("name") == name or data.get("port") == port:
                raise ValueError(f"HomeKit name/port collision for {name}:{port}")
        if entry is None:
            now = datetime.now(timezone.utc).isoformat()
            entry = {
                "created_at": now, "modified_at": now, "data": {},
                "disabled_by": None, "discovery_keys": {}, "domain": "homekit",
                "entry_id": uuid4().hex, "minor_version": 1, "options": {},
                "pref_disable_new_entities": False, "pref_disable_polling": False,
                "source": "user", "subentries": [], "unique_id": None, "version": 1,
            }
            entries.append(entry)
            action = "Create"
        else:
            if entry.get("source") != "user" or entry.get("disabled_by"):
                raise ValueError(f"Cannot manage disabled/non-user accessory {name}")
            action = "Update"
        previous = deepcopy(entry)
        entry["data"].update({"name": name, "port": port})
        entry["title"] = f"{name}:{port}"
        options = entry["options"]
        options["mode"] = "accessory"
        options["filter"] = {"include_domains": [], "include_entities": [entity],
                             "exclude_domains": [], "exclude_entities": []}
        options.setdefault("entity_config", {}).setdefault(entity, {}).update({
            key: camera[key] for key in ("linked_motion_sensor", "video_codec", "support_audio")
        })
        if previous != entry:
            entry["modified_at"] = datetime.now(timezone.utc).isoformat()
            changes.append(f"{action} accessory: {name}:{port} ({entity})")
    return updated, changes


class HAApi:
    def __init__(self):
        self.base = os.environ["HA_WEBSOCKET_URL"].replace("wss://", "https://", 1).replace("ws://", "http://", 1).removesuffix("/api/websocket").rstrip("/")
        self.token = os.environ["HOME_ASSISTANT_API_KEY"]

    def request(self, path: str, data=None):
        request = Request(self.base + path, data=None if data is None else json.dumps(data).encode(),
                          headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"})
        try:
            with urlopen(request, timeout=30) as response:
                return json.load(response)
        except HTTPError as error:
            # Flow responses may contain credentials. Never echo their body.
            raise RuntimeError(f"HA API request failed (HTTP {error.code})") from None


def frigate_plan(entries: dict, config: dict) -> tuple[dict | None, dict | None]:
    settings = config["frigate_rtsp"]
    if not settings:
        return None, None
    matches = [entry for entry in entries["data"]["entries"] if entry.get("domain") == "frigate"
               and entry.get("data", {}).get("url") == settings["integration_url"]]
    if len(matches) != 1:
        raise ValueError("Expected exactly one matching Frigate integration")
    credentials = json.loads(subprocess.check_output([
        "doppler", "secrets", "get", settings["username_secret"], settings["password_secret"],
        "--project", settings["doppler_project"], "--config", settings["doppler_config"], "--json",
    ], text=True))
    user = credentials[settings["username_secret"]]["computed"]
    password = credentials[settings["password_secret"]]["computed"]
    if not user or not password:
        raise ValueError("RTSP credentials must not be empty")
    template = f"rtsp://{quote(user, safe='')}:{quote(password, safe='')}@{settings['host']}:8554/{{{{ name }}}}"
    entry = matches[0]
    options = dict(entry.get("options", {}))
    options["rtsp_url_template"] = template
    return entry, options


def apply_frigate(api: HAApi, entry: dict, options: dict) -> None:
    flow = api.request("/api/config/config_entries/options/flow", {"handler": entry["entry_id"]})
    if flow.get("type") != "form" or flow.get("step_id") != "init":
        raise RuntimeError("Unexpected Frigate options flow; no options submitted")
    result = api.request(f"/api/config/config_entries/options/flow/{flow['flow_id']}", options)
    if result.get("type") != "create_entry":
        raise RuntimeError("Frigate options flow did not complete (response withheld for credential safety)")
    print("Updated Frigate RTSP template through options API (credentials redacted)")


@contextmanager
def deployment_lock(server: str):
    command = f"flock -n {LOCK} sh -c 'echo LOCKED; cat >/dev/null'"
    process = subprocess.Popen(["ssh", server, command], stdin=subprocess.PIPE,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    try:
        if process.stdout.readline().strip() != "LOCKED":
            raise RuntimeError(f"HA deployment lock is busy or unavailable: {LOCK}; wait for its owner")
        yield
    finally:
        process.communicate(timeout=15)
        if process.returncode not in (0, None):
            print("Warning: deployment-lock SSH session ended unsuccessfully", file=sys.stderr)


def upload_json(server: str, path: str, value: dict) -> None:
    """Secret-bearing payload stays in a 0600 tempfile, uploaded then atomically renamed."""
    remote_temp = f"{path}.homekit-{uuid4().hex}.tmp"
    with tempfile.NamedTemporaryFile(mode="w", suffix=".json") as file:
        json.dump(value, file, indent=2)
        file.flush()
        try:
            subprocess.run(["scp", "-q", file.name, f"{server}:{remote_temp}"], check=True)
            subprocess.run(["ssh", server, f"chmod 600 {shlex.quote(remote_temp)} && mv {shlex.quote(remote_temp)} {shlex.quote(path)}"], check=True)
        finally:
            subprocess.run(["ssh", server, f"rm -f {shlex.quote(remote_temp)}"], check=False)


def write_storage(server: str, config: dict) -> None:
    print("Stopping HA before updating storage...")
    # Even a lost SSH response may mean the stop succeeded: always attempt start.
    try:
        subprocess.run(["ssh", server, "ha core stop"], check=True, capture_output=True)
        # Stop flushes in-memory entries: download AGAIN, never upload a stale snapshot.
        current = download_config_entries(server)
        updated, changes = reconcile_entries(current, config)
        if changes:
            backup = f"{STORAGE}.homekit-backup-{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S')}-{uuid4().hex[:8]}"
            subprocess.run(["ssh", server, f"umask 077; cp {STORAGE} {backup} && chmod 600 {backup}"], check=True)
            print(f"Storage backup: {backup}")
            upload_json(server, STORAGE, updated)
    finally:
        print("Starting HA...")
        subprocess.run(["ssh", server, "ha core start"], check=True, capture_output=True)


def verify_loaded(api: HAApi, expected_ids: set[str]) -> None:
    for _ in range(60):
        try:
            entries = api.request("/api/config/config_entries/entry")
            states = {entry["entry_id"]: entry["state"] for entry in entries}
            if expected_ids and all(states.get(entry_id) == "loaded" for entry_id in expected_ids):
                print(f"Verified {len(expected_ids)} managed integrations loaded")
                return
        except (URLError, TimeoutError, RuntimeError):
            pass
        time.sleep(3)
    raise RuntimeError("Managed integrations did not all load within 3 minutes; inspect HA logs")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="Plan only; no flow, stop/start, storage or lock writes")
    args = parser.parse_args()
    if not os.environ.get("HA_SERVER"):
        os.execvp("doppler", ["doppler", "run", "--", sys.executable, *sys.argv])
    root = Path(__file__).resolve().parents[2]
    config_path = root / "config" / "homekit_exposed.yaml"
    config = load_homekit_config(config_path)
    server = os.environ["HA_SERVER"]
    api = HAApi()

    def plan():
        entries = download_config_entries(server)
        _, changes = reconcile_entries(entries, config)
        entry, options = frigate_plan(entries, config)
        frigate_changed = entry is not None and entry.get("options", {}) != options
        for change in changes:
            print(change)
        if frigate_changed:
            print("Update Frigate RTSP template (Doppler credentials redacted)")
        if not changes and not frigate_changed:
            print("No changes needed")
        return changes, entry, options, frigate_changed

    if args.dry_run:
        plan()
        print("Dry run — no changes made")
        return
    with deployment_lock(server):
        # The lock spans planning, activation, loaded-state verification, and provenance.
        prior = subprocess.run(["ssh", server, f"test ! -f {DEPLOYMENT} || cat {DEPLOYMENT}"], capture_output=True, text=True, check=True)
        if prior.stdout.strip():
            record = json.loads(prior.stdout)
            print(f"Previous HomeKit deployment source: {record.get('source')}")
        changes, entry, options, frigate_changed = plan()
        if not changes and not frigate_changed:
            return
        if frigate_changed:
            apply_frigate(api, entry, options)
        if changes:
            write_storage(server, config)
        final = download_config_entries(server)
        _, remaining = reconcile_entries(final, config)
        final_frigate, final_options = frigate_plan(final, config)
        if remaining or (final_frigate and final_frigate.get("options", {}) != final_options):
            raise RuntimeError("Post-deployment configuration differs from desired state")
        expected = {find_homekit_bridge_entry(final)["entry_id"]}
        entities = {camera["entity_id"] for camera in config["camera_accessories"]}
        expected.update(e["entry_id"] for e in final["data"]["entries"] if e.get("domain") == "homekit"
                        and e.get("options", {}).get("mode") == "accessory"
                        and set(e["options"].get("filter", {}).get("include_entities", [])) & entities)
        if final_frigate:
            expected.add(final_frigate["entry_id"])
        verify_loaded(api, expected)
        upload_json(server, DEPLOYMENT, {
            "source": str(root), "branch": subprocess.check_output(["git", "-C", str(root), "branch", "--show-current"], text=True).strip(),
            "config_sha256": hashlib.sha256(config_path.read_bytes()).hexdigest(),
            "task_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            "deployed_at": datetime.now(timezone.utc).isoformat(), "status": "loaded",
        })
        print("HomeKit configuration deployed. Existing pairing state retained; pair new accessories in Home.")


if __name__ == "__main__":
    try:
        main()
    except (ValueError, RuntimeError, subprocess.CalledProcessError, URLError, TimeoutError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)
